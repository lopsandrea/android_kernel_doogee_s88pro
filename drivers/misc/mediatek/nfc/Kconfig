#
# STMicroelectronics ST21NFC / ST54 NFC chip (the secure element SPI channel).
#
# It matches CONFIG_NFC_CHIP_SUPPORT=y and CONFIG_NFC_ST54_SPI=y in the factory
# config (e977_dg_m13_71_q0.config, lines 1976 and 1977). The two lines sit
# right after CONFIG_MTK_TINYSYS_MCUPM_PLT_SUPPORT, which is the last "source"
# in drivers/misc/mediatek/Kconfig: that is why the file is sourced
# down there and not elsewhere -- the order of the options in an expanded .config
# is the traversal order of the Kconfig.
#
# The two options are a single block of symbols in the factory kernel:
# NFC_CHIP_SUPPORT wholly contains NFC_ST54_SPI (31 contiguous functions in
# stock.map, 17 from st21nfc.c and 14 from st54spi.c). They remain two translation
# units, and the factory .ddebug says so with the KBUILD_MODNAMEs 'st21nfc' and
# 'st54spi'.
#
config NFC_CHIP_SUPPORT
	bool "ST21NFC NFC controller (I2C/NCI)"
	depends on I2C
	default n
	help
	  STMicroelectronics ST21NFC NFC driver: /dev/st21nfc character device,
	  I2C read/write towards the NCI controller, reset and IRQ GPIOs, ioctls
	  for polarity and reset. Reconstructed by reading the disassembled
	  factory kernel of the Doogee S88 Pro -- see
	  docs/bringup/driver-riscritti.md.

config NFC_ST54_SPI
	bool "ST54 secure element SPI channel"
	depends on SPI && NFC_CHIP_SUPPORT
	default n
	help
	  SPI channel towards the ST54 secure element, with power management and
	  a callback registered on the ST21NFC driver
	  (st21nfc_register_st54spi_cb). Reconstructed exclusively by reading the
	  driver in the stock oracle; it does not derive from spidev sources or
	  from other phones' drivers.
