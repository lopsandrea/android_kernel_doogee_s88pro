config MTK_IMGSENSOR
	bool CONFIG_MTK_IMGSENSOR
	default n
	help
	  CONFIG_MTK_IMGSENSOR

#
# THE FACTORY OPTIONS THAT WERE MISSING, declared on 2026-08-26.
#
# The factory .config has them all at =y and our tree did not declare them
# at all: `olddefconfig` discards a symbol no Kconfig defines, so there was
# no way to turn them on.
#
# BEWARE, and this has to be said before reading them as "added features":
# **none of these guards protects code that exists in this tree.**
# Turning them on aligns the .config with the factory kernel and does not change
# a byte of the binary. They serve two purposes:
#
#   1. removing fifteen differences from the config comparison, which is one
#      of the three measurements of the project;
#   2. giving the code somewhere to attach to when it gets written.
#
# Where they sit is our own choice, by subsystem: the factory Kconfig is not
# among the recovered files, and deriving it from the binary is impossible
# -- a Kconfig symbol leaves no trace in compiled code.
#

config WTK_SUB2_CAMERA_SUPPORT
	bool "second secondary camera (factory name)"
	default y

config WTK_SUB2_CAMERA_YUV_SUPPORT
	bool "the second secondary is YUV (factory name)"
	default y

config WTK_MAIN_CAMERA_AVDD_GPIO
