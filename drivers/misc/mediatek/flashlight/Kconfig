config MTK_FLASHLIGHT_DEBUG
	bool "Mediatek flashlight debugging messages"
	depends on MTK_FLASHLIGHT
	default n
	help
	  Say Y here if you want the flashlight to produce a bunch of debug
	  messages to the system log.

	  Select this if you are having a problem with flashlight support
	  and want to see more of what is going on.

config MTK_FLASHLIGHT_PT
	bool "Mediatek flashlight power throttling"
	depends on MTK_FLASHLIGHT
	default n
	help
	  This is for flashlight power throttling.

	  Power throttling will limit flashlight function,
	  such as disable flashlight, decrease brightness level or
	  change flash mode to torch mode.

config MTK_FLASHLIGHT_PT_STRICT
    bool "Mediatek flashlight power throttling (strict)"
	depends on MTK_FLASHLIGHT_PT
	default n
	help
	  This is for flashlight strict power throttling.

	  Strict power throttling will disable flashlight when
	  over-current, low battary voltage and low battary percentage
	  situations.

config MTK_FLASHLIGHT_DLPT
    bool "Mediatek flashlight dynamic low power throttling"
	depends on MTK_FLASHLIGHT
	default n
	help
	  This is for flashlight dynamic low power throttling.

	  Dynamic low power throttling is a mechanism to monitor
	  the current of battary dynamicly. It will start by request
	  and notice user by kernel notifier.

#
# LE OPZIONI DI FABBRICA CHE MANCAVANO, dichiarate il 2026-08-26.
#
# Il .config di fabbrica le ha tutte a =y e il nostro albero non le
# dichiarava affatto: `olddefconfig` scarta un simbolo che nessun Kconfig
# definisce, quindi non c'era modo di accenderle.
#
# ATTENZIONE, e va detto prima di leggerle come «funzioni aggiunte»:
# **nessuna di queste guardia protegge codice che esista in questo albero.**
# Accenderle allinea il .config al kernel di fabbrica e non cambia un byte
# del binario. Servono a due cose:
#
#   1. togliere quindici differenze dal confronto dei config, che e' una
#      delle tre misure del progetto;
#   2. dare un posto dove attaccare il codice quando lo si scrivera'.
#
# Il posto in cui stanno lo abbiamo scelto noi, per sottosistema: il Kconfig
# di fabbrica non e' fra i file recuperati, e dedurlo dal binario non si puo'
# -- un simbolo di Kconfig non lascia traccia nel codice compilato.
#

config WTK_MAIN_FLASHLIGHT_CH0
	bool "canale 0 del flash principale (nome di fabbrica)"
	default y
	help
	  Il .config di fabbrica ha CONFIG_WTK_MAIN_FLASHLIGHT_CH0=y.

	  In questo albero il nome compare in quattro file -- flashlight-device.c,
	  flashlights-mt6370.c e mt6370_pmu_charger.c -- ma SOLO NEI COMMENTI:
	  nessun #ifdef lo prova. Il blocco flashlight misura comunque 90
	  funzioni su 90 uguali alla fabbrica, quindi finora non e' mancato
	  niente, e accendere questa voce non cambia il codice generato.
